# Proyecto de Supabase. Se copian de Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave publica del cliente. Los proyectos nuevos la llaman "publishable key" y los
# anteriores "anon key": sirve cualquiera de las dos variables.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
